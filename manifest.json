{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.66rpg.com/game/*"
      ],
      "js": [
        "time-points.js",
        "markdown.js",
        "card-text.js",
        "bulk-favorite.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.66rpg.com/h5/*",
        "https://66rpg.com/h5/*"
      ],
      "js": [
        "time-points.js",
        "game-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
