{
  "manifest_version": 3,
  "name": "橙光攻略整理器",
  "version": "0.22.0",
  "description": "在橙光作品页整理、收藏、导入、导出攻略评论，并高亮带游戏年月的剧情点。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.66rpg.com/game/*"],
      "js": ["time-points.js", "markdown.js", "bulk-favorite.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.66rpg.com/h5/*", "https://66rpg.com/h5/*"],
      "js": ["time-points.js", "game-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
