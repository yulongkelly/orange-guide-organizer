{
  "manifest_version": 3,
  "name": "橙光攻略整理器",
  "version": "0.20.0",
  "description": "在橙光作品页整理、收藏、导入和导出攻略评论。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.66rpg.com/game/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
